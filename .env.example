# Copy to .env and adjust. .env is git-ignored.

# Nominatim/Overpass usage policy: identify your application, ideally with contact info.
# Example: qgis-property-report/0.2 (contact: you@example.com)
OSM_USER_AGENT=qgis-property-report/0.2 (PyQGIS location report demo)

# Optional alternative Overpass endpoints (comma-separated, tried in order)
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# Overpass response cache. Default: /cache/overpass (./cache/overpass on the host).
# Point it to the bundled sample responses for an offline demo:
# OVERPASS_CACHE_DIR=/samples/overpass_cache
